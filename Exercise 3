
.card {
    width: 300px;
    box-sizing: border-box;
    border: 1px solid gray;
    margin: 20px;
    background-color: white;
    color: #333;
}

.card img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.card-content {
    padding: 20px;
}

.card h2 {
    font-size: 22px;
    margin-top: 0;
    margin-bottom: 15px;
}

.card p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 15px;
}

.card button {
    background-color: #1a73e8;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.card button:hover {
    background-color: #174ea6;
}